    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst raw = body.content || body.message || body.text || '';\n\nconst lines = raw\n  .split('\\n')\n  .map(x => x.trim())\n  .filter(x => x !== '');\n\nconst employeeName = lines[0] || '';\nconst company = (lines[1] || '').toUpperCase();\n\nconst jnLine = lines[2] || '';\nconst fourthLine = lines[3] || '';\n\nconst allowedCompanies = ['TT', 'TSC', 'CD', 'DD', 'RCS', 'SB', 'TTX', 'TTI', 'W'];\n\nlet jnCode = '';\nlet jnQty = null;\nlet msCode = '';\nlet msQty = null;\nlet comment = '';\n\n// Parse JN line (required)\nconst jnMatch = jnLine.match(/^([A-Z]+)-(\\d+)$/i);\nif (jnMatch) {\n  jnCode = jnMatch[1].toUpperCase();\n  jnQty = Number(jnMatch[2]);\n}\n\n// Check if 4th line is MS format or just comment\nconst msMatch = fourthLine.match(/^([A-Z]+)-(\\d+)$/i);\n\nif (msMatch) {\n  msCode = msMatch[1].toUpperCase();\n  msQty = Number(msMatch[2]);\n\n  // Comment starts from line 5 onward\n  comment = lines.slice(4).join(' ');\n} else {\n  // No MS line, treat line 4 onward as comment\n  comment = lines.slice(3).join(' ');\n}\n\n// Build final fields for Excel\nlet jobCode = '';\nlet finishedQty = '';\n\nif (jnCode && jnQty !== null && msCode && msQty !== null) {\n  jobCode = `${jnCode}-${msCode}`;\n  finishedQty = `${jnQty}-${msQty}`;\n} else if (jnCode && jnQty !== null) {\n  jobCode = jnCode;\n  finishedQty = String(jnQty);\n}\n\nreturn [\n  {\n    json: {\n      timestamp: new Date().toISOString(),\n      discordUser:\n        body.username ||\n        body.author?.username ||\n        body.member?.user?.username ||\n        '',\n      employeeName,\n      company,\n      jobCode,\n      finishedQty,\n      comment,\n      rawMessage: raw,\n      isValid:\n        employeeName !== '' &&\n        allowedCompanies.includes(company) &&\n        jnCode === 'JN' &&\n        jnQty !== null &&\n        (\n          msCode === '' ||\n          msCode === 'MS'\n        ) &&\n        (\n          msCode === '' ||\n          msQty !== null\n        )\n    }\n  }\n];"
      },
